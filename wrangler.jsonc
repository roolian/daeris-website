// Déploiement Cloudflare (Workers, fichiers statiques) : chaque commit relance
// `npm run build` puis `npx wrangler deploy`, qui publie le dossier dist/.
// Pour un client : changer seulement "name" (nom de l'app dans Cloudflare).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daeris-website",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist"
  }
}
