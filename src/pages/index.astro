---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import CallToAction from '../components/CallToAction.astro';
import Contact from '../components/Contact.astro';
import { getHome, getOffers, getSite } from '../lib/content';

const [site, home, offers] = await Promise.all([getSite(), getHome(), getOffers()]);
---

<BaseLayout title={home.seoTitle || undefined} description={home.seoDescription || undefined}>
  <Hero hero={home.hero} />
  <Services services={home.services} />
  <Pricing heading={home.offers} offers={offers} />
  <Process process={home.process} />
  <CallToAction cta={home.cta} />
  <Contact contact={home.contact} site={site} />
</BaseLayout>
