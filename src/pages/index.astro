---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import { loadHomeData } from '../lib/tina';

const data = await loadHomeData();
---

<BaseLayout title={data.home.seoTitle || undefined} description={data.home.seoDescription || undefined}>
  <TinaIsland name="home" wrapper={{ tag: 'div' }} primary>
    <HomeSections {...data} />
  </TinaIsland>
</BaseLayout>
