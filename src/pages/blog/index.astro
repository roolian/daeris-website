---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
);
---

<BaseLayout title="Blog — Daeris" description="Conseils de visibilité locale pour les commerçants et TPE de Brive et de Corrèze.">
  <section aria-labelledby="blog-title" class="container-site py-24 sm:py-32">
    <SectionHeading id="blog-title" section={{ eyebrow: 'Blog', title: 'Conseils de visibilité locale' }} />
    <ul class="mt-16 divide-y divide-line border-y border-line">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block py-8">
            <time datetime={post.data.publishedDate.toISOString()} class="label">{formatDate(post.data.publishedDate)}</time>
            <h2 class="mt-3 text-2xl font-light tracking-wide group-hover:underline group-hover:underline-offset-8">{post.data.title}</h2>
            {post.data.description && <p class="mt-3 max-w-2xl text-muted">{post.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
