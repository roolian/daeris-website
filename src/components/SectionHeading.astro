---

interface Props {
  id: string;
  section: { eyebrow?: string | null; title?: string | null; intro?: string | null };
  align?: 'left' | 'center';
}
const { id, section, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {section.eyebrow && (
    <p class="label mb-5 flex items-center gap-4">
      <span class="h-px w-8 bg-paper/40" aria-hidden="true"></span>{section.eyebrow}
    </p>
  )}
  {section.title && (
    <h2 id={id} class="text-3xl font-extralight leading-tight tracking-wide sm:text-4xl">
      {section.title}
    </h2>
  )}
  {section.intro && <p class="mt-5 text-lg leading-relaxed text-muted">{section.intro}</p>}
</div>
