---
import SectionHeading from './SectionHeading.astro';
import type { Home } from '../lib/content';

interface Props {
  id?: string;
  process: Home['process'];
}
const { id = 'methodologie', process } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-b border-line py-24 sm:py-32">
  <div class="container-site">
    <SectionHeading id={`${id}-title`} eyebrow={process.eyebrow} title={process.title} intro={process.intro} />

    <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {process.steps.map((step, i) => (
        <li class="border-t border-line pt-6">
          <div class="flex items-baseline gap-4">
            <span class="text-3xl font-extralight text-muted" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-sm font-normal uppercase tracking-label">{step.title}</h3>
          </div>
          <p class="mt-4 leading-relaxed text-paper/80">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
