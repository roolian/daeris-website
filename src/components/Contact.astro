---
import SectionHeading from './SectionHeading.astro';
import type { Home, Site } from '../lib/content';

interface Props {
  id?: string;
  contact: Home['contact'];
  site: Site;
}
const { id = 'contact', contact, site } = Astro.props;
const endpoint = site.formEndpoint || undefined;

const field = 'mt-2 w-full border border-line bg-transparent px-4 py-3 text-paper placeholder:text-paper/40 focus:border-paper focus:outline-none';
const label = 'text-xs font-normal uppercase tracking-label text-paper/80';
---

<section id={id} aria-labelledby={`${id}-title`} class="py-24 sm:py-32">
  <div class="container-site grid gap-16 lg:grid-cols-[1fr_1.3fr]">
    <div>
      <SectionHeading id={`${id}-title`} eyebrow={contact.eyebrow} title={contact.title} intro={contact.intro} />

      <dl class="mt-12 space-y-6 text-paper/90">
        {site.phone && (
          <div><dt class="label">Téléphone</dt><dd class="mt-1"><a href={`tel:${site.phoneE164}`} class="hover:underline">{site.phone}</a></dd></div>
        )}
        {site.email && (
          <div><dt class="label">Email</dt><dd class="mt-1"><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></dd></div>
        )}
        <div>
          <dt class="label">Adresse</dt>
          <dd class="mt-1"><address class="not-italic">{site.street}<br />{site.postalCode} {site.city}</address></dd>
        </div>
        {site.openingHours && <div><dt class="label">Horaires</dt><dd class="mt-1">{site.openingHours}</dd></div>}
      </dl>
    </div>

    <!-- Endpoint à brancher via Keystatic (Coordonnées & SEO → Endpoint du formulaire) -->
    <form method="post" action={endpoint} class="grid gap-6 sm:grid-cols-2" data-endpoint={endpoint ? 'on' : 'off'}>
      <div>
        <label for="c-name" class={label}>Nom *</label>
        <input id="c-name" name="name" type="text" autocomplete="name" required class={field} />
      </div>
      <div>
        <label for="c-business" class={label}>Activité</label>
        <input id="c-business" name="business" type="text" autocomplete="organization" class={field} placeholder="Restaurant, boutique…" />
      </div>
      <div>
        <label for="c-email" class={label}>Email *</label>
        <input id="c-email" name="email" type="email" autocomplete="email" required class={field} />
      </div>
      <div>
        <label for="c-phone" class={label}>Téléphone</label>
        <input id="c-phone" name="phone" type="tel" autocomplete="tel" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="c-message" class={label}>Votre projet *</label>
        <textarea id="c-message" name="message" rows="5" required class={field}></textarea>
      </div>
      <!-- Anti-spam (honeypot) -->
      <div class="hidden" aria-hidden="true">
        <label for="c-website">Ne pas remplir</label>
        <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-muted">
          Vos données servent uniquement à vous répondre. <a href="/mentions-legales" class="underline underline-offset-4">En savoir plus</a>
        </p>
        <button type="submit" class="btn btn-primary">Envoyer</button>
      </div>
      <p class="hidden text-sm text-muted sm:col-span-2" role="status" data-form-status></p>
    </form>
  </div>
</section>

<script>
  // Tant qu'aucun endpoint n'est configuré, on bloque l'envoi et on l'indique (POC).
  document.querySelectorAll<HTMLFormElement>('form[data-endpoint="off"]').forEach((form) =>
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      if (status) {
        status.textContent = 'Formulaire en cours de branchement : écrivez-nous directement par email en attendant.';
        status.classList.remove('hidden');
      }
    }),
  );
</script>
