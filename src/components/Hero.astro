---
import type { Home } from '../lib/content';

interface Props {
  hero: Home['hero'];
}
const { hero } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative overflow-hidden border-b border-line">
  <!-- Lignes fines décoratives -->
  <svg class="pointer-events-none absolute inset-0 h-full w-full text-paper/[0.06]" aria-hidden="true">
    <defs>
      <pattern id="hero-grid" width="96" height="96" patternUnits="userSpaceOnUse">
        <path d="M96 0H0V96" fill="none" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" />
  </svg>

  <div class="container-site relative grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-[1.25fr_1fr] lg:py-36">
    <div>
      {hero.eyebrow && (
        <p class="label mb-8 flex items-center gap-4">
          <span class="h-px w-10 bg-paper/50" aria-hidden="true"></span>{hero.eyebrow}
        </p>
      )}
      <h1 id="hero-title" class="text-4xl font-extralight leading-[1.1] tracking-wide text-balance sm:text-5xl lg:text-6xl">
        {hero.title}
      </h1>
      {hero.subtitle && <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted sm:text-xl">{hero.subtitle}</p>}
      <div class="mt-12 flex flex-wrap gap-4">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-ghost">{hero.secondary.label}</a>
      </div>
    </div>

    <div class="relative mx-auto flex aspect-square w-full max-w-xs items-center justify-center lg:max-w-md" aria-hidden="true">
      <div class="absolute inset-0 rounded-full border border-line/50"></div>
      <div class="absolute inset-[9%] rounded-full border border-line"></div>
      <!-- Placeholder : loup extrait de l'icône PNG, à remplacer par le SVG officiel -->
      <div class="relative aspect-[256/196] w-3/4 overflow-hidden">
        <img src="/brand/icon-256x256.png" alt="" width="256" height="256" class="w-full mix-blend-lighten" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>
